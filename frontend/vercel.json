{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "unsafe-none"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pages/student/login.html",
      "destination": "/login.html",
      "permanent": true
    },
    {
      "source": "/pages/owner/login.html",
      "destination": "/login.html",
      "permanent": true
    }
  ]
}
